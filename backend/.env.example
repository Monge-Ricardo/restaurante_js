# Copia este archivo como .env y ajusta los valores.
# Conexión a MongoDB. Puede ser una cadena local o de MongoDB Atlas.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=Restaurante_GR07

# Tiempo máximo de espera al conectar con MongoDB (milisegundos).
MONGODB_TIMEOUT_MS=5000

# Secreto de sesión. En producción usa una cadena aleatoria larga.
SESSION_SECRET=cambia-este-secreto-en-produccion

# Puerto HTTP.
PORT=3000

# Entorno (development | production).
NODE_ENV=development

# Contraseñas iniciales de los usuarios sembrados.
SEED_ADMIN_PASSWORD=admin123
SEED_CAJERO_PASSWORD=cajero123
