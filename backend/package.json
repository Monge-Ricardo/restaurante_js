{
  "name": "restaurante-js",
  "version": "1.0.0",
  "private": true,
  "description": "Port a Node.js/Express del sistema Restaurante_MongoDB_GR07 (ASP.NET MVC + MongoDB).",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "npm run test:node && npm run test:jest",
    "test:node": "node --test test/api/clientesCategorias.test.js test/documents.test.js test/format.test.js test/ids.test.js test/validaciones.test.js test/views.test.js",
    "test:jest": "jest --config test.config.js --runInBand",
    "test:coverage": "jest --config test.config.js --coverage --runInBand",
    "test:facturacion": "jest --config test.config.js --runInBand --runTestsByPath test/api/facturacion.test.js",
    "test:facturacion:coverage": "jest --config test.config.js --coverage --runInBand --runTestsByPath test/api/facturacion.test.js",
    "test:platos": "jest --config test.config.js --runInBand --runTestsByPath test/api/platos.test.js",
    "test:platos:coverage": "jest --config test.config.js --coverage --runInBand --runTestsByPath test/api/platos.test.js",
    "test:coverage:clientes": "jest --config jest.config.js --coverage --runInBand --collectCoverageFrom=src/**/cliente* --collectCoverageFrom=src/**/categoria*",
    "test:coverage:platos": "jest --config jest.config.js --coverage --runInBand --runTestsByPath test/api/platos.test.js --collectCoverageFrom=src/controllers/api/platosApiController.js --collectCoverageFrom=src/routes/api/platosRoutes.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:facturacion": "eslint src/controllers/api/facturacionApiController.js src/controllers/facturacionController.js src/routes/api/facturacionRoutes.js test/api/facturacion.test.js",
    "lint:clientes": "eslint src/controllers/api/ClientesApiController.js src/controllers/api/categoriasApiController.js src/controllers/clientesController.js src/models/Cliente.js src/models/Categoria.js",
    "lint:clientes:fix": "eslint --fix src/controllers/api/ClientesApiController.js src/controllers/api/categoriasApiController.js src/controllers/clientesController.js src/models/Cliente.js src/models/Categoria.js",
    "lint:platos": "eslint src/controllers/api/platosApiController.js src/controllers/platosController.js src/routes/api/platosRoutes.js src/models/Plato.js test/api/platos.test.js",
    "lint:platos:fix": "eslint --fix src/controllers/api/platosApiController.js src/controllers/platosController.js src/routes/api/platosRoutes.js src/models/Plato.js test/api/platos.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "mongodb": "^6.12.0",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "supertest": "^7.3.1"
  }
}
