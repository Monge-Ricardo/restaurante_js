{
  "info": {
    "_postman_id": "a0fb9170-a4e8-4dc9-8058-76d6d8936ab2",
    "name": "Restaurante - API de facturación",
    "description": "Flujo manual de salud, historial, emisión, consulta y anulación de facturas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "desde", "value": "2026-01-01" },
    { "key": "hasta", "value": "2026-12-31" },
    { "key": "idCliente", "value": "CLI001" },
    { "key": "idEmpresa", "value": "LOC001" },
    { "key": "idEmpleado", "value": "EMP001" },
    { "key": "idPlato", "value": "PLA001" },
    { "key": "idFactura", "value": "" }
  ],
  "item": [
    {
      "name": "GET Salud API",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/api/v1/health" }
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Responde HTTP 200', () => pm.response.to.have.status(200));",
            "pm.test('Confirma API activa', () => pm.expect(pm.response.json().success).to.eql(true));"
          ]
        }
      }]
    },
    {
      "name": "GET Listar facturas",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/api/v1/facturas" }
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Responde HTTP 200', () => pm.response.to.have.status(200));",
            "pm.test('Devuelve una lista JSON', () => { const body = pm.response.json(); pm.expect(body.success).to.eql(true); pm.expect(body.data).to.be.an('array'); });"
          ]
        }
      }]
    },
    {
      "name": "GET Filtrar facturas por fecha",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/api/v1/facturas?desde={{desde}}&hasta={{hasta}}",
          "query": [
            { "key": "desde", "value": "{{desde}}" },
            { "key": "hasta", "value": "{{hasta}}" }
          ]
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Responde HTTP 200', () => pm.response.to.have.status(200));",
            "pm.test('Devuelve una lista JSON', () => { const body = pm.response.json(); pm.expect(body.success).to.eql(true); pm.expect(body.data).to.be.an('array'); });"
          ]
        }
      }]
    },
    {
      "name": "POST Emitir factura",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"idCliente\": \"{{idCliente}}\",\n  \"idEmpresa\": \"{{idEmpresa}}\",\n  \"idEmpleado\": \"{{idEmpleado}}\",\n  \"detalles\": [\n    { \"idPlato\": \"{{idPlato}}\", \"cantidad\": 2 }\n  ]\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/api/v1/facturas" }
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Responde HTTP 201', () => pm.response.to.have.status(201));",
            "const body = pm.response.json();",
            "pm.test('Devuelve la factura emitida', () => { pm.expect(body.success).to.eql(true); pm.expect(body.data.id_factura).to.match(/^FAC\\d+$/); });",
            "if (body.success && body.data && body.data.id_factura) pm.collectionVariables.set('idFactura', body.data.id_factura);"
          ]
        }
      }]
    },
    {
      "name": "GET Consultar factura emitida",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/api/v1/facturas/{{idFactura}}" }
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Responde HTTP 200', () => pm.response.to.have.status(200));",
            "pm.test('Incluye detalle y totales', () => { const body = pm.response.json(); pm.expect(body.success).to.eql(true); pm.expect(body.data.detalleFacturas).to.be.an('array').that.is.not.empty; pm.expect(body.data.totales.total).to.be.a('number'); });"
          ]
        }
      }]
    },
    {
      "name": "DELETE Anular factura",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/api/v1/facturas/{{idFactura}}" }
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Responde HTTP 200', () => pm.response.to.have.status(200));",
            "pm.test('Cambia el estado a ANULADA', () => { const body = pm.response.json(); pm.expect(body.success).to.eql(true); pm.expect(body.data.estado).to.eql('ANULADA'); });"
          ]
        }
      }]
    }
  ]
}
