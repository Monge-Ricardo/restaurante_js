<%- include('../partials/header', { title: title }) %>

<div class="container mt-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold text-dark">🍔 Catálogo de Platos</h2>
      <p class="text-muted">Administra el menú del restaurante organizado por sus categorías.</p>
    </div>
    <div>
      <% if (tienePermiso('crear_plato')) { %>
        <a href="/Platos/Crear" class="btn btn-primary fw-bold px-4 shadow-sm">➕ Agregar Nuevo Plato</a>
      <% } %>
      <a href="/Home/Index" class="btn btn-outline-secondary px-3 ms-2">Volver al Panel</a>
    </div>
  </div>

  <% grupos.forEach(function (grupo) { %>
    <div class="mb-5">
      <h4 class="fw-bold text-primary mb-3 d-flex align-items-center">
        <span class="me-2">📁</span> <%= grupo.nombre %>
        <span class="badge bg-secondary ms-2 fs-6"><%= grupo.platos.length %></span>
      </h4>

      <div class="card shadow-sm border-0" style="border-radius: 12px;">
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light text-secondary small text-uppercase">
                <tr>
                  <th style="width: 15%" class="ps-4">Código</th>
                  <th style="width: 15%">Imagen</th>
                  <th style="width: 20%">Nombre</th>
                  <th style="width: 30%">Descripción</th>
                  <th style="width: 10%">Precio</th>
                  <th style="width: 10%" class="text-center pe-4">Acciones</th>
                </tr>
              </thead>
              <tbody>
                <% grupo.platos.forEach(function (plato) { %>
                  <tr>
                    <td class="ps-4"><span class="badge bg-dark fw-bold"><%= plato.id_plato %></span></td>
                    <td>
                      <% if (plato.imagen) { %>
                        <img src="<%= plato.imagen %>" class="img-thumbnail rounded shadow-sm" style="width: 70px; height: 70px; object-fit: cover;" alt="<%= plato.nombre %>" />
                      <% } else { %>
                        <div class="bg-light text-muted d-flex align-items-center justify-content-center rounded border" style="width: 70px; height: 70px; font-size: 0.75rem;">Sin Foto</div>
                      <% } %>
                    </td>
                    <td><span class="fw-bold text-dark"><%= plato.nombre %></span></td>
                    <td>
                      <p class="text-muted small mb-0 text-truncate" style="max-width: 300px;" title="<%= plato.descripcion %>"><%= plato.descripcion %></p>
                    </td>
                    <td><span class="fw-bold text-success">$<%= formatMoney(plato.precio) %></span></td>
                    <td class="text-center pe-4">
                      <div class="d-inline-flex gap-2">
                        <% if (tienePermiso('editar_plato')) { %>
                          <a href="/Platos/Editar/<%= encodeURIComponent(plato.id_plato) %>" class="btn btn-warning btn-sm fw-bold px-3">✏️ Editar</a>
                        <% } %>
                        <% if (tienePermiso('eliminar_plato')) { %>
                          <a href="/Platos/Eliminar/<%= encodeURIComponent(plato.id_plato) %>" class="btn btn-sm btn-outline-danger px-2">🗑️ Eliminar</a>
                        <% } %>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  <% }); %>

  <% if (platos.length === 0) { %>
    <div class="alert alert-light border text-center text-muted py-5" style="border-radius: 15px;">
      <span class="fs-1 d-block mb-2">🍽️</span>
      <h5>No hay ningún plato registrado en el menú todavía.</h5>
      <% if (tienePermiso('crear_plato')) { %>
        <a href="/Platos/Crear" class="btn btn-primary btn-sm mt-2 fw-bold">Registrar el Primer Plato</a>
      <% } %>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
