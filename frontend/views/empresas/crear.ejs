<%- include('../partials/header', { title: title }) %>

<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card shadow border-0" style="border-radius: 15px;">
        <div class="card-header bg-primary text-white py-3">
          <h4 class="mb-0 fw-bold">Registrar Nueva Empresa / Local</h4>
        </div>
        <div class="card-body p-4">
          <form id="formEmpresa" action="/Empresas/Crear" method="post" enctype="multipart/form-data">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

            <div class="mb-3">
              <label for="rucInput" class="form-label fw-bold text-secondary">RUC del Local</label>
              <input type="text" id="rucInput" name="ruc" class="form-control" maxlength="13" required value="<%= empresa.ruc || '' %>" />
              <% const errorRuc = fieldError(errors, 'ruc'); %>
              <span id="errorRuc" class="text-danger small" style="<%= errorRuc ? '' : 'display:none;' %>"><%= errorRuc ? errorRuc.message : '' %></span>
            </div>

            <div class="mb-3">
              <label for="nombre" class="form-label fw-bold text-secondary">Nombre Comercial o Razón Social</label>
              <input type="text" id="nombre" name="nombre" class="form-control" required maxlength="50" value="<%= empresa.nombre || '' %>" />
              <% const errorNombre = fieldError(errors, 'nombre'); %>
              <% if (errorNombre) { %><span class="text-danger small"><%= errorNombre.message %></span><% } %>
            </div>

            <div class="mb-4">
              <label class="form-label fw-bold text-secondary">Logotipo del Local</label>
              <input type="file" name="logo" id="logoArchivo" class="form-control" accept="image/*" required onchange="previewImage(event)" />
              <small class="text-muted">JPG, JPEG, PNG, WEBP o GIF. Máximo 5 MB.</small>
              <% const errorLogo = fieldError(errors, 'logo'); %>
              <% if (errorLogo) { %><span class="text-danger small d-block"><%= errorLogo.message %></span><% } %>
              <div class="mt-3 text-center">
                <img id="vistaPrevia" src="#" alt="Previsualización" class="img-thumbnail d-none" style="max-height: 120px; object-fit: cover;" />
              </div>
            </div>

            <hr class="text-muted" />

            <div class="d-flex justify-content-end gap-2">
              <a href="/Empresas" class="btn btn-outline-secondary px-4">Cancelar</a>
              <button type="submit" class="btn btn-primary px-4 fw-bold">Guardar Empresa</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer', { pageScripts: ['/Scripts/validaciones.js', '/Scripts/empresas-form.js'] }) %>
