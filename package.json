{
  "name": "restaurante-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Workspace raíz del proyecto Restaurante JS",
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "start": "npm --workspace=backend start",
    "dev": "npm --workspace=backend run dev",
    "test": "npm --workspace=backend test",
    "test:jest": "npm --workspace=backend run test:jest",
    "test:coverage": "npm --workspace=backend run test:coverage",
    "test:coverage:clientes": "npm --workspace=backend run test:coverage:clientes",
    "test:node": "npm --workspace=backend run test:node",
    "lint": "npm --workspace=backend run lint",
    "lint:fix": "npm --workspace=backend run lint:fix",
    "lint:clientes": "npm --workspace=backend run lint:clientes",
    "lint:clientes:fix": "npm --workspace=backend run lint:clientes:fix"
  }
}
